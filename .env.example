DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hacode_tasks
PORT=3000

# Azure AI Foundry
# AZURE_AI_ENDPOINT  → Project endpoint from Foundry portal
#                      e.g. https://<project>.eastus2.inference.ml.azure.com
# AZURE_AI_KEY       → API key from Foundry portal (Keys & Endpoints)
# AZURE_AI_DEPLOYMENT → Deployment name you gave the model in Foundry
#                       e.g. gpt-4o  or  phi-4  or  Llama-3.3-70B-Instruct
# AZURE_AI_API_VERSION → Leave as default unless Foundry tells you otherwise
AZURE_AI_ENDPOINT=https://<project>.<region>.inference.ml.azure.com
AZURE_AI_KEY=your_azure_ai_key_here
AZURE_AI_DEPLOYMENT=gpt-4o
AZURE_AI_API_VERSION=2024-05-01-preview
